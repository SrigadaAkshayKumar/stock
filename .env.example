# Copy to .env and fill in your values. Frontend reads REACT_APP_ vars at build time.
REACT_APP_API_URL=http://localhost:10000
REACT_APP_ACCESS_KEY=your-web3forms-key

REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXX123

# Backend (set next to backend/app.py or as env vars)
NEWS_API_KEY=your-newsapi-key
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_STOCK=900
CACHE_TTL_PRED=3600
