# Copy to backend/.env and fill in what you need. Everything is optional;
# the platform runs offline on the bundled CSV data without any keys.

APP_ENV=development
PORT=10000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Market data: set to true to fetch live/near-live prices and fundamentals via yfinance
LIVE_MARKET_DATA=false
DEFAULT_EXCHANGE_SUFFIX=.NS

# News (https://newsapi.org)
NEWS_API_KEY=

# AI agent answer synthesis (optional). Without a key the agent uses rule-based synthesis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_ENABLED=true

# Storage: "excel" during development; PostgreSQL schema lives in db/schema.sql
DB_BACKEND=excel
STORAGE_DIR=./storage

# Caching (Redis optional; falls back to in-memory)
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_ANALYSIS=600

# Reliability
RATE_LIMIT_PER_MINUTE=30
WORKER_THREADS=4
PREDICTION_HORIZONS=1,5
